{
  "name": "vida-tierra",
  "version": "0.3.2",
  "type": "module",
  "private": true,
  "description": "Sitio de lectura para la investigacion epistemologica '¿Como sabemos lo que sabemos?'",
  "scripts": {
    "brand:build": "node scripts/generate-brand-assets.mjs",
    "prepare-site": "node scripts/prepare-site.mjs",
    "dev": "npm run prepare-site && next dev",
    "build": "npm run prepare-site && next build",
    "start": "next start",
    "validate": "pwsh -NoProfile -File scripts/validate-repository.ps1",
    "validate:citas": "node scripts/validate-citations.mjs",
    "generate:data": "node scripts/generate-public-data.mjs",
    "validate:data": "node scripts/validate-public-data.mjs",
    "normalize:frontmatter": "node scripts/normalize-research-frontmatter.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3-geo": "^3.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.33.0",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "topojson-client": "^3.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^6.0.3"
  }
}
